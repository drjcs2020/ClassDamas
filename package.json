{
  "name": "dama-classmana-independent",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node duel-api/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:online": "node tests/online-e2e.mjs",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:migrate:local": "wrangler d1 migrations apply classdamas-db --local",
    "cf:dev": "npm run cf:build && wrangler dev --local --port 8787",
    "cf:test": "node scripts/test-cloudflare.mjs",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  }
}
